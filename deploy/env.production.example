# The .env of the API on the server. provision.sh makes it from this file (the values in __DOUBLE_UNDERSCORES__ are filled
# in from what it was told or generated) and keeps it in /var/www/rideidle/shared/.env, outside the releases, so that a new
# release finds it where it was. It is never overwritten. Edit it there; a change takes effect with the next deploy.

APP_NAME=RideIdle
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__
# The web app is on the same domain, under /. The links in the e-mails and the way back from Google, Facebook and Apple lead here.
WEB_URL=https://__DOMAIN__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Logs are kept for two weeks, as the privacy policy says they are kept only as long as security needs them.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rideidle
DB_USERNAME=rideidle
DB_PASSWORD=__DB_PASSWORD__

# The API sends no cookies and keeps no session.
SESSION_DRIVER=file

# The cache holds the counters that limit abuse: Redis is faster for it than the database. provision.sh writes `database`
# here when it is told that the server is shared (SHARED_SERVER=1) and the Redis of the server needs a password.
# The game uses database number 5 of Redis, so that an `artisan cache:clear` on this site or on another one that shares the
# Redis (it empties the whole database of the cache) does not reach the data of the other.
CACHE_STORE=__CACHE_STORE__
CACHE_PREFIX=rideidle_
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=5
REDIS_CACHE_DB=5

# The queue is in the database on purpose: it only carries a few e-mails, and the command that deletes an account
# can then also remove the mails that wait for it (it cannot look into Redis).
QUEUE_CONNECTION=database

# Who sends the e-mails. The address in MAIL_FROM_ADDRESS must be allowed to send from this provider: SPF and DKIM
# of its domain must say so, or the links to sign in end up in spam. See deploy/README.md.
MAIL_MAILER=smtp
# MAIL_SCHEME is smtp for port 587 (it starts TLS when the server offers it) and smtps for port 465.
MAIL_HOST=__MAIL_HOST__
MAIL_PORT=__MAIL_PORT__
MAIL_SCHEME=__MAIL_SCHEME__
MAIL_USERNAME="__MAIL_USERNAME__"
MAIL_PASSWORD="__MAIL_PASSWORD__"
MAIL_FROM_ADDRESS="__MAIL_FROM_ADDRESS__"
MAIL_FROM_NAME="${APP_NAME}"

# The terms and the privacy policy. The minimum age is a legal decision (see docs/prawo.md). The operator and the
# contact address are shown on both pages, and a page shows a detail that is missing in red.
LEGAL_MIN_AGE=16
LEGAL_VERSION=2026-10-23
# Empty: every change of LEGAL_VERSION asks the drivers for a new consent. Set it to the day of the last change that must.
LEGAL_CONSENT_VERSION=
LEGAL_OPERATOR_NAME="__LEGAL_OPERATOR_NAME__"
LEGAL_OPERATOR_ADDRESS="__LEGAL_OPERATOR_ADDRESS__"
LEGAL_CONTACT_EMAIL="__LEGAL_CONTACT_EMAIL__"

# Payments with real money. Not on yet: the page of payment of Stripe comes with the test keys, and a lawyer reads the terms of sale first (docs/api-runs.md, "Płatności prawdziwymi pieniędzmi").
# The keys are written here by the owner, on the server, and nowhere else; a game takes real money only after `php8.4 artisan payments:switch on`. A test key (sk_test_ or
# rk_test_) is refused in production unless PAYMENTS_ALLOW_TEST=1, and a live key is refused outside it. The webhook of Stripe is https://__DOMAIN__/api/v1/webhooks/stripe,
# and `php8.4 artisan payments:status` says where it all stands.
# PREMIUM_PROVIDER=stripe
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTS_ALLOW_TEST=0

# Sign in with Google, Facebook and Apple. A provider is on only when its keys are set. The address to register at each
# of them is https://__DOMAIN__/api/v1/auth/{google|facebook|apple}/callback, and the privacy policy and the terms are
# https://__DOMAIN__/privacy and https://__DOMAIN__/terms. See docs/konto.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Where the game reads its content from. `files` is the content/ folder of the release; `database` is the pack that is live in the
# database, which is what lets the content change without a deploy (the first deploy with `database` installs the pack of the
# release, with content:check --install). Change it to `database` when you want that; the content is the same either way.
CONTENT_SOURCE=files

# The network of games. The panel can put a game on a domain of its own: it writes a job and a worker on this server (the timer rideidle-domains, which provision.sh
# installs) carries it out: nginx and a certificate from Let's Encrypt (deploy/README.md, "Domeny gier z panelu").
# ACME_EMAIL is where Let's Encrypt writes about the certificate of such a domain; the panel gives it to the worker. provision.sh fills it with ADMIN_EMAIL.
ACME_EMAIL="__ADMIN_EMAIL__"
# The public addresses of THIS server, with commas between them. The panel compares them with the A record of the domain of a game, and says whether it points here
# before it asks for a job. Left empty, it compares with the address that the host of WEB_URL has now (the first game is on this server, so that is the server).
SERVER_IPS=

# The admin panel (F4). ADMIN_DOMAIN is the host it answers on, which deploy/admin-site.sh sets up (nginx, a certificate) and writes here. While it is empty
# nothing in nginx sends a request to the panel, so it cannot be reached. The panel signs in with a cookie, which only travels over HTTPS.
ADMIN_DOMAIN=
ADMIN_LOCALE=pl
SESSION_SECURE_COOKIE=true

# The AI assistant of the panel (most AI v2): an app of Claude connects to the host of the panel with OAuth and MCP, after a person of the panel gives it a
# consent. Switch it off with false. The addresses an app may be sent back to after the consent (comma separated); the default is the apps of Claude and localhost
# (Claude Code). The keys of OAuth are made once with `artisan passport:keys` (see deploy/README.md).
# AGENT_ENABLED=true
# AGENT_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,http://localhost
# How long a call of the assistant waits for a long study (the gates) before it gives the number of the job: 50 s fits the host of the panel (nginx waits 120 s);
# with the panel under /admin of the host of the game (nginx waits 30 s) set 20.
# AGENT_WAIT_SECONDS=50
