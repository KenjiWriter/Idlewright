APP_NAME=RideIdle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The web app, where the links of e-mails and the returns from a sign-in lead.
WEB_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokalnie MariaDB lub MySQL (Laragon), w CI mariadb i pgsql, na produkcji pgsql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ride_idle
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The terms and the privacy policy. The minimum age is a legal decision (see docs/konto.md): 16 is a careful working
# value until the legal review. The version is the day the texts were last changed. The operator is shown on both pages.
LEGAL_MIN_AGE=16
LEGAL_VERSION=2026-10-23
# Empty: every change of LEGAL_VERSION asks the drivers for a new consent. Set it to the day of the last change that must.
LEGAL_CONSENT_VERSION=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=

# Web push (docs/api-runs.md, "Powiadomienia push"): the hosts of the push services of browsers that the server will send to, comma separated. Leave it out for the usual ones
# (Google, Mozilla, Apple, Windows). The keys of a game are made once with `php artisan push:keys`; they are encrypted with APP_KEY, so keep APP_KEY with the backups.
# PUSH_HOSTS=

# Payments with real money (docs/api-runs.md, "Płatności prawdziwymi pieniędzmi"). PREMIUM_PROVIDER is `fake` (no money is taken; development only) or `stripe` (the
# page of payment comes with the test keys). The keys are written by the owner here and never in the repository; the mode is the one of the key (sk_test_/rk_test_ or
# sk_live_/rk_live_), and a test key in production needs PAYMENTS_ALLOW_TEST=1. A game that was never told takes payments outside production and not in it:
# `php artisan payments:switch on|off`, `php artisan payments:status`.
PREMIUM_PROVIDER=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ALLOW_TEST=false

# Sign in with Google, Facebook and Apple. A provider is on only when its keys are set.
# The redirect address to register at each of them is APP_URL + /api/v1/auth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple: the Services ID, and either a ready client secret (at most six months old) or the team, the key and the
# absolute path of the private key (.p8), from which the secret is made.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Where the game reads its content from: files (the content/ folder of the repository) or database (the pack that is live in the
# database: php artisan content:import --activate puts one there, and a deploy does it the first time). Runs are frozen with the
# number of the pack, or with RIDE_RULESET_VERSION when the content is read from files.
CONTENT_SOURCE=files
# RIDE_RULESET_VERSION=dev
